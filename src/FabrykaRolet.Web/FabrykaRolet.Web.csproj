<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FabrykaRolet.Domain\FabrykaRolet.Domain.csproj" />
    <ProjectReference Include="..\FabrykaRolet.Application\FabrykaRolet.Application.csproj" />
    <ProjectReference Include="..\FabrykaRolet.Infrastructure\FabrykaRolet.Infrastructure.csproj" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Źródła TypeScript nie są częścią publikowanej aplikacji .NET - buduje je Vite do wwwroot/dist. -->
    <Content Remove="client\**" />
    <None Include="client\**" Exclude="client\node_modules\**;client\dist-check\**" />
  </ItemGroup>

</Project>
