@page
@model FabrykaRolet.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Strona główna";
    var isAdminPreview = User.Identity?.IsAuthenticated == true && ViewContext.HttpContext.Request.Query["adminPreview"] == "1";
}

<section class="hero container relative">
    @if (isAdminPreview)
    {
        <a asp-page="/Admin/Tresci/Index" class="absolute right-0 top-0 z-10 rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-semibold text-stone-700 shadow-sm">Edytuj teksty strony głównej</a>
    }
    <h1>@Model.HeroTitle</h1>
    <p class="hero__lead">
        @Model.HeroLead
    </p>
</section>

<section class="section-cards container">
    <a class="section-card relative" asp-page="/NaZewnatrz">
        @if (isAdminPreview)
        {
            <span class="absolute right-4 top-4 rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-semibold text-stone-700 shadow-sm">Edytowane w: Treści stron</span>
        }
        <h2>@Model.ExteriorCardTitle</h2>
        <p>@Model.ExteriorCardBody</p>
        <span class="section-card__cta">@Model.ExteriorCardCta</span>
    </a>
    <a class="section-card relative" asp-page="/Wewnatrz">
        @if (isAdminPreview)
        {
            <span class="absolute right-4 top-4 rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-semibold text-stone-700 shadow-sm">Edytowane w: Treści stron</span>
        }
        <h2>@Model.InteriorCardTitle</h2>
        <p>@Model.InteriorCardBody</p>
        <span class="section-card__cta">@Model.InteriorCardCta</span>
    </a>
</section>
