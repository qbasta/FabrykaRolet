@page
@model FabrykaRolet.Web.Pages.SystemyModel
@{
    ViewData["Title"] = "Wszystkie systemy";
}

<div class="bg-stone-100 min-h-full">
    <div id="systems-page" class="max-w-6xl mx-auto px-4 md:px-8 py-8 space-y-8">

        <header>
            <h1 class="text-3xl font-bold text-stone-900 tracking-tight">Wszystkie systemy</h1>
            <p class="text-stone-500 mt-1">Pełny katalog systemów Fabryki Rolet — przefiltruj po lokalizacji montażu albo przewiń całość.</p>
        </header>

        <nav class="flex flex-wrap gap-2 pb-2 border-b border-stone-200" aria-label="Filtry kategorii">
            <input type="radio" name="systems-filter" id="filter-all" class="peer/all sr-only" checked>
            <label for="filter-all" class="cursor-pointer px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-white text-stone-600 border border-stone-200 hover:bg-stone-200 peer-checked/all:bg-stone-900 peer-checked/all:text-white peer-checked/all:shadow-md peer-checked/all:border-stone-900">
                Wszystkie <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-stone-100 text-stone-500">@Model.Systems.Count</span>
            </label>

            <input type="radio" name="systems-filter" id="filter-exterior" class="peer/ext sr-only">
            <label for="filter-exterior" class="cursor-pointer px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-white text-stone-600 border border-stone-200 hover:bg-stone-200 peer-checked/ext:bg-stone-900 peer-checked/ext:text-white peer-checked/ext:shadow-md peer-checked/ext:border-stone-900">
                Systemy zewnętrzne <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-stone-100 text-stone-500">@Model.ExteriorCount</span>
            </label>

            <input type="radio" name="systems-filter" id="filter-interior" class="peer/int sr-only">
            <label for="filter-interior" class="cursor-pointer px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-white text-stone-600 border border-stone-200 hover:bg-stone-200 peer-checked/int:bg-stone-900 peer-checked/int:text-white peer-checked/int:shadow-md peer-checked/int:border-stone-900">
                Systemy wewnętrzne <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-stone-100 text-stone-500">@Model.InteriorCount</span>
            </label>
        </nav>

        <main id="systems-results" class="space-y-6">
            @foreach (var system in Model.Systems)
            {
                var sectionSlug = system.Section == FabrykaRolet.Domain.Entities.HouseSection.Exterior ? "exterior" : "interior";
                var sectionLabel = system.Section == FabrykaRolet.Domain.Entities.HouseSection.Exterior ? "System zewnętrzny" : "System wewnętrzny";

                <article
                    id="@system.Id"
                    data-section="@sectionSlug"
                    class="system-pill scroll-mt-24 bg-white rounded-3xl p-6 md:p-8 border border-stone-200/80 shadow-sm hover:shadow-md transition-shadow duration-300 space-y-4
                           target:ring-2 target:ring-accent target:ring-offset-2 target:ring-offset-stone-100">

                    <div>
                        <span class="text-xs font-semibold uppercase tracking-wider text-accent bg-accent-soft px-3 py-1 rounded-full border border-accent/20">
                            @sectionLabel
                        </span>
                        <h2 class="text-2xl font-bold text-stone-900 mt-2">@system.Name</h2>
                        <p class="text-stone-600 mt-2 text-sm leading-relaxed">@system.ShortDescription</p>
                    </div>

                    @if (system.Advantages.Count > 0)
                    {
                        <ul class="space-y-1.5 py-3 border-y border-stone-100 text-sm text-stone-600">
                            @foreach (var advantage in system.Advantages)
                            {
                                <li class="flex items-start gap-2">
                                    <svg class="w-4 h-4 mt-0.5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    <span>@advantage</span>
                                </li>
                            }
                        </ul>
                    }

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
                        <div>
                            <span class="block text-stone-400 font-medium mb-1 uppercase tracking-wider">Dostępne materiały</span>
                            <span class="font-semibold text-stone-700">@string.Join(", ", system.Materials)</span>
                        </div>
                        <div>
                            <span class="block text-stone-400 font-medium mb-1 uppercase tracking-wider">Montaż / zastosowanie</span>
                            <span class="font-semibold text-stone-700">@system.Mounting</span>
                        </div>
                        <div>
                            <span class="block text-stone-400 font-medium mb-1 uppercase tracking-wider">Sterowanie</span>
                            <span class="font-semibold text-stone-700">@system.Control</span>
                        </div>
                        <div>
                            <span class="block text-stone-400 font-medium mb-1 uppercase tracking-wider">Max. wymiary</span>
                            <span class="font-semibold text-stone-700">@system.MaxDimensions</span>
                        </div>
                    </div>

                </article>
            }
        </main>

    </div>
</div>
