@page
@model FabrykaRolet.Web.Pages.SystemyModel
@{
    ViewData["Title"] = "Wszystkie systemy";
    var isAdminPreview = User.Identity?.IsAuthenticated == true && ViewContext.HttpContext.Request.Query["adminPreview"] == "1";
}

<div class="bg-stone-100 min-h-full">
    <div id="systems-page" class="max-w-6xl mx-auto px-4 md:px-8 py-8 space-y-8">

        <header class="relative">
            @if (isAdminPreview)
            {
                <a asp-page="/Admin/Tresci/Index" class="absolute right-0 top-0 hidden rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-semibold text-stone-700 shadow-sm xl:inline-flex">Edytuj nagłówek katalogu</a>
            }
            <h1 class="text-3xl font-bold text-stone-900 tracking-tight">@Model.PageHeading</h1>
            <p class="text-stone-500 mt-1">@Model.PageLead</p>
        </header>

        <nav class="flex flex-wrap gap-2 pb-2 border-b border-stone-200" aria-label="Filtry kategorii">
            <input type="radio" name="systems-filter" id="filter-all" class="peer/all sr-only" checked>
            <label for="filter-all" class="cursor-pointer px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-white text-stone-600 border border-stone-200 hover:bg-stone-200 peer-checked/all:bg-stone-900 peer-checked/all:text-white peer-checked/all:shadow-md peer-checked/all:border-stone-900">
                Wszystkie <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-stone-100 text-stone-500">@Model.Systems.Count</span>
            </label>

            <input type="radio" name="systems-filter" id="filter-exterior" class="peer/ext sr-only">
            <label for="filter-exterior" class="cursor-pointer px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-white text-stone-600 border border-stone-200 hover:bg-stone-200 peer-checked/ext:bg-stone-900 peer-checked/ext:text-white peer-checked/ext:shadow-md peer-checked/ext:border-stone-900">
                Systemy zewnętrzne <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-stone-100 text-stone-500">@Model.ExteriorCount</span>
            </label>

            <input type="radio" name="systems-filter" id="filter-interior" class="peer/int sr-only">
            <label for="filter-interior" class="cursor-pointer px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-white text-stone-600 border border-stone-200 hover:bg-stone-200 peer-checked/int:bg-stone-900 peer-checked/int:text-white peer-checked/int:shadow-md peer-checked/int:border-stone-900">
                Systemy wewnętrzne <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-stone-100 text-stone-500">@Model.InteriorCount</span>
            </label>
        </nav>

        <main id="systems-results" class="space-y-6">
            @foreach (var system in Model.Systems)
            {
                var sectionSlug = system.Section == FabrykaRolet.Domain.Entities.HouseSection.Exterior ? "exterior" : "interior";
                var sectionLabel = system.Section == FabrykaRolet.Domain.Entities.HouseSection.Exterior ? "System zewnętrzny" : "System wewnętrzny";
                var images = Model.SystemImages.TryGetValue(system.Id, out var assignedImages) ? assignedImages : Array.Empty<string>();
                var slideCount = images.Count > 0 ? images.Count : 1;

                <article
                    id="@system.Id"
                    data-section="@sectionSlug"
                    class="system-pill scroll-mt-24 bg-white rounded-3xl p-6 md:p-8 border border-stone-200/80 shadow-sm transition-all duration-300 space-y-4 relative">

                    @if (isAdminPreview)
                    {
                        <div class="absolute right-6 top-6 z-10 hidden flex-wrap gap-2 xl:flex">
                            <a asp-page="/Admin/Systemy/Edytuj" asp-route-id="@system.Id" class="rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-semibold text-stone-700 shadow-sm">Edytuj treść</a>
                            <a asp-page="/Admin/Systemy/Zdjecia" asp-route-id="@system.Id" class="rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-semibold text-stone-700 shadow-sm">Zdjęcia</a>
                        </div>
                    }

                    <div class="system-pill__layout">
                        <section
                            class="system-carousel"
                            data-system-carousel
                            data-system-name="@system.Name"
                            aria-label="Galeria systemu @system.Name">

                            <div class="system-carousel__frame">
                                <div
                                    class="system-carousel__viewport"
                                    tabindex="@(images.Count > 1 ? "0" : "-1")"
                                    data-carousel-viewport
                                    aria-roledescription="karuzela"
                                    aria-label="@(images.Count > 1 ? $"Karuzela zdjęć systemu {system.Name}" : $"Podgląd systemu {system.Name}")">

                                    @if (images.Count > 0)
                                    {
                                        @for (var slideIndex = 0; slideIndex < images.Count; slideIndex++)
                                        {
                                            var imagePath = images[slideIndex].Contains('/') ? images[slideIndex] : $"/images/systems/{images[slideIndex]}";
                                            <div
                                                class="system-carousel__slide @(slideIndex == 0 ? "is-active" : null)"
                                                data-carousel-slide
                                                role="group"
                                                aria-roledescription="slajd"
                                                aria-label="Zdjęcie @(slideIndex + 1) z @slideCount"
                                                aria-hidden="@(slideIndex == 0 ? "false" : "true")">
                                                <img
                                                    class="system-carousel__image"
                                                    src="@imagePath"
                                                    alt="@($"{system.Name} – zdjęcie {slideIndex + 1}")"
                                                    loading="lazy" />
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div
                                            class="system-carousel__slide system-carousel__slide--placeholder is-active"
                                            data-carousel-slide
                                            role="group"
                                            aria-roledescription="slajd"
                                            aria-label="Placeholder zdjęć dla systemu @system.Name"
                                            aria-hidden="false">
                                            <div class="system-carousel__placeholder" aria-hidden="true">
                                                <svg class="system-carousel__placeholder-icon" viewBox="0 0 48 48" fill="none">
                                                    <rect x="7" y="8" width="34" height="28" rx="6" stroke="currentColor" stroke-width="2.5"></rect>
                                                    <path d="M14 30l7-8 6 6 4-5 7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                                    <circle cx="18" cy="17" r="3" fill="currentColor"></circle>
                                                </svg>
                                                <span class="system-carousel__placeholder-title">Zdjęcia w przygotowaniu</span>
                                                <span class="system-carousel__placeholder-copy">@system.Name</span>
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (images.Count > 1)
                                {
                                    <button
                                        type="button"
                                        class="system-carousel__nav system-carousel__nav--prev"
                                        data-carousel-prev
                                        aria-label="Pokaż poprzednie zdjęcie systemu @system.Name">
                                        <span aria-hidden="true">‹</span>
                                    </button>
                                    <button
                                        type="button"
                                        class="system-carousel__nav system-carousel__nav--next"
                                        data-carousel-next
                                        aria-label="Pokaż następne zdjęcie systemu @system.Name">
                                        <span aria-hidden="true">›</span>
                                    </button>
                                }
                            </div>

                            @if (images.Count > 1)
                            {
                                <div class="system-carousel__meta">
                                    <div class="system-carousel__dots" role="group" aria-label="Wybór zdjęcia systemu @system.Name">
                                        @for (var slideIndex = 0; slideIndex < images.Count; slideIndex++)
                                        {
                                            <button
                                                type="button"
                                                class="system-carousel__dot @(slideIndex == 0 ? "is-active" : null)"
                                                data-carousel-dot
                                                data-slide-index="@slideIndex"
                                                aria-label="Pokaż zdjęcie @(slideIndex + 1) z @slideCount"
                                                aria-pressed="@(slideIndex == 0 ? "true" : "false")"></button>
                                        }
                                    </div>
                                    <p class="system-carousel__counter" data-carousel-counter aria-hidden="true">1 / @slideCount</p>
                                </div>
                            }

                            <p class="sr-only" data-carousel-status aria-live="polite" aria-atomic="true">
                            @(images.Count > 1 ? $"{system.Name}: zdjęcie 1 z {slideCount}" : $"{system.Name}: podgląd bez dodatkowych zdjęć")
                            </p>
                        </section>

                        <div class="space-y-4 min-w-0">
                            <div>
                                <span class="text-xs font-semibold uppercase tracking-wider text-accent bg-accent-soft px-3 py-1 rounded-full border border-accent/20">
                                    @sectionLabel
                                </span>
                                <h2 class="text-2xl font-bold text-stone-900 mt-2">@system.Name</h2>
                                <p class="text-stone-600 mt-2 text-sm leading-relaxed">@system.ShortDescription</p>
                            </div>

                            @if (system.Advantages.Count > 0)
                            {
                                <ul class="space-y-1.5 py-3 border-y border-stone-100 text-sm text-stone-600">
                                    @foreach (var advantage in system.Advantages)
                                    {
                                        <li class="flex items-start gap-2">
                                            <svg class="w-4 h-4 mt-0.5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                            <span>@advantage</span>
                                        </li>
                                    }
                                </ul>
                            }

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                                <div>
                                    <span class="block text-stone-400 font-medium mb-1 uppercase tracking-wider">Dostępne materiały</span>
                                    <span class="font-semibold text-stone-700">@string.Join(", ", system.Materials)</span>
                                </div>
                                <div>
                                    <span class="block text-stone-400 font-medium mb-1 uppercase tracking-wider">Montaż / zastosowanie</span>
                                    <span class="font-semibold text-stone-700">@system.Mounting</span>
                                </div>
                                <div>
                                    <span class="block text-stone-400 font-medium mb-1 uppercase tracking-wider">Sterowanie</span>
                                    <span class="font-semibold text-stone-700">@system.Control</span>
                                </div>
                                <div>
                                    <span class="block text-stone-400 font-medium mb-1 uppercase tracking-wider">Max. wymiary</span>
                                    <span class="font-semibold text-stone-700">@system.MaxDimensions</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </article>
            }
        </main>

    </div>
</div>
