@page
@model FabrykaRolet.Web.Pages.Admin.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Logowanie";
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Logowanie – panel administratora</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/dist/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-stone-100 text-stone-900 font-sans">
    <main class="mx-auto flex min-h-screen max-w-md items-center px-4 py-8">
        <section class="w-full rounded-3xl border border-stone-200 bg-white p-8 shadow-sm">
            <p class="text-xs uppercase tracking-[0.3em] text-stone-400">Fabryka Rolet</p>
            <h1 class="mt-2 text-2xl font-semibold">Logowanie administratora</h1>
            <p class="mt-2 text-sm text-stone-600">Dostęp do edycji systemów, treści i zdjęć.</p>

            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="mt-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">@Model.Message</div>
            }

            <form method="post" class="mt-6 space-y-4">
                <div>
                    <label asp-for="Input.UserName" class="block text-sm font-medium text-stone-700">Login</label>
                    <input asp-for="Input.UserName" class="mt-1 w-full rounded-xl border border-stone-300 px-3 py-2" autocomplete="username" />
                    <span asp-validation-for="Input.UserName" class="text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Input.Password" class="block text-sm font-medium text-stone-700">Hasło</label>
                    <input asp-for="Input.Password" class="mt-1 w-full rounded-xl border border-stone-300 px-3 py-2" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="text-sm text-red-600"></span>
                </div>
                <button type="submit" class="w-full rounded-xl bg-stone-900 px-4 py-2 text-sm font-medium text-white">Zaloguj</button>
            </form>
        </section>
    </main>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
