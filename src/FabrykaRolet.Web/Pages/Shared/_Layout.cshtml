<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – Fabryka Rolet</title>

    <link rel="icon" type="image/png" href="~/images/logo/favicon.png" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/dist/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <noscript>
        <style>
            @@media (max-width: 767px) {
                [data-mobile-nav-toggle] { display: none !important; }
                [data-mobile-nav-menu][hidden] { display: block !important; }
            }
        </style>
    </noscript>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="font-sans text-ink min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">Przejdź do treści</a>

    <header class="border-b border-stone-200">
        <div class="container mx-auto max-w-6xl px-4 md:px-8 py-4">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between md:gap-6">
                <div class="flex items-center justify-between gap-4">
                    <a href="/" class="flex min-w-0 items-center gap-2 group" aria-label="Fabryka Rolet – strona główna">
                        <img src="~/images/logo/fr-icon.png" alt="" class="h-9 w-auto shrink-0 transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-105" asp-append-version="true" />
                        <span class="font-bold text-lg md:text-xl tracking-tight text-stone-900">Fabryka Rolet</span>
                    </a>

                    <button
                        type="button"
                        class="inline-flex items-center justify-center rounded-xl border border-stone-200 p-2 text-stone-700 transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none md:hidden"
                        data-mobile-nav-toggle
                        aria-label="Otwórz menu główne"
                        aria-controls="mobile-nav-menu"
                        aria-expanded="false">
                        <svg data-mobile-nav-open-icon class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 7h16"></path>
                            <path d="M4 12h16"></path>
                            <path d="M4 17h16"></path>
                        </svg>
                        <svg data-mobile-nav-close-icon class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 6l12 12"></path>
                            <path d="M18 6L6 18"></path>
                        </svg>
                    </button>
                </div>

            </div>

            <nav aria-label="Nawigacja główna">
                <div class="hidden md:flex gap-x-6 gap-y-1">
                    <a asp-page="/Index" class="relative text-sm font-medium text-stone-600 hover:text-accent transition-colors py-1 after:content-[''] after:absolute after:left-0 after:right-0 after:-bottom-0.5 after:h-0.5 after:bg-accent after:scale-x-0 after:origin-left after:transition-transform after:duration-300 hover:after:scale-x-100">Strona główna</a>
                    <a asp-page="/NaZewnatrz" class="relative text-sm font-medium text-stone-600 hover:text-accent transition-colors py-1 after:content-[''] after:absolute after:left-0 after:right-0 after:-bottom-0.5 after:h-0.5 after:bg-accent after:scale-x-0 after:origin-left after:transition-transform after:duration-300 hover:after:scale-x-100">Na zewnątrz</a>
                    <a asp-page="/Wewnatrz" class="relative text-sm font-medium text-stone-600 hover:text-accent transition-colors py-1 after:content-[''] after:absolute after:left-0 after:right-0 after:-bottom-0.5 after:h-0.5 after:bg-accent after:scale-x-0 after:origin-left after:transition-transform after:duration-300 hover:after:scale-x-100">Wewnątrz</a>
                    <a asp-page="/Systemy" class="relative text-sm font-medium text-stone-600 hover:text-accent transition-colors py-1 after:content-[''] after:absolute after:left-0 after:right-0 after:-bottom-0.5 after:h-0.5 after:bg-accent after:scale-x-0 after:origin-left after:transition-transform after:duration-300 hover:after:scale-x-100">Wszystkie systemy</a>
                    <a asp-page="/Kontakt" class="relative text-sm font-medium text-stone-600 hover:text-accent transition-colors py-1 after:content-[''] after:absolute after:left-0 after:right-0 after:-bottom-0.5 after:h-0.5 after:bg-accent after:scale-x-0 after:origin-left after:transition-transform after:duration-300 hover:after:scale-x-100">Kontakt</a>
                </div>

                <div
                    id="mobile-nav-menu"
                    class="mt-4 space-y-1 border-t border-stone-200 pt-4 md:hidden"
                    data-mobile-nav-menu
                    hidden>
                    <a asp-page="/Index" data-mobile-nav-link class="block rounded-xl px-3 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none">Strona główna</a>
                    <a asp-page="/NaZewnatrz" data-mobile-nav-link class="block rounded-xl px-3 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none">Na zewnątrz</a>
                    <a asp-page="/Wewnatrz" data-mobile-nav-link class="block rounded-xl px-3 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none">Wewnątrz</a>
                    <a asp-page="/Systemy" data-mobile-nav-link class="block rounded-xl px-3 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none">Wszystkie systemy</a>
                    <a asp-page="/Kontakt" data-mobile-nav-link class="block rounded-xl px-3 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none">Kontakt</a>
                </div>
            </nav>
        </div>
    </header>

    @if (User.Identity?.IsAuthenticated == true && Context.Request.Query["adminPreview"] == "1")
    {
        <div class="border-b border-amber-200 bg-amber-50">
            <div class="container mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm md:px-8">
                <p class="font-medium text-amber-900">Tryb podglądu administratora — zwykli użytkownicy tego nie widzą.</p>
                <div class="flex flex-wrap gap-2">
                    <a asp-page="/Admin/Index" class="rounded-full border border-amber-300 bg-white px-3 py-1 font-medium text-amber-900">Panel</a>
                    <a href="@Context.Request.Path" class="rounded-full border border-amber-300 bg-white px-3 py-1 font-medium text-amber-900">Wyłącz podgląd</a>
                </div>
                <p class="w-full text-amber-900 xl:hidden">Na telefonie i tablecie podgląd pozostaje tylko do odczytu. Przyciski edycji pokażą się dopiero na komputerze.</p>
            </div>
        </div>
    }

    <main id="main-content" class="flex-1">
        @RenderBody()
    </main>

    <footer class="mt-16 border-t border-stone-200 bg-stone-50">
        <div class="container mx-auto max-w-6xl px-4 md:px-8 py-6 flex items-center gap-3 text-sm text-stone-500">
            <img src="~/images/logo/fr-icon.png" alt="" class="h-6 w-auto opacity-70" asp-append-version="true" />
            <p>&copy; @DateTime.Now.Year Fabryka Rolet. Wszelkie prawa zastrzeżone.</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
    <script type="module" src="~/dist/site.js" asp-append-version="true"></script>
</body>
</html>
