@using Microsoft.AspNetCore.Authorization
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – Panel administracyjny</title>
    <link rel="stylesheet" href="~/dist/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-screen bg-stone-100 text-stone-900">
    <div class="min-h-screen lg:grid lg:grid-cols-[18rem_minmax(0,1fr)]">
        <aside class="border-b border-stone-200 bg-white lg:min-h-screen lg:border-b-0 lg:border-r">
            <div class="flex items-center justify-between gap-3 px-6 py-5">
                <div>
                    <p class="text-xs uppercase tracking-[0.3em] text-stone-400">Fabryka Rolet</p>
                    <h1 class="text-lg font-semibold">Panel administratora</h1>
                </div>
                <a asp-page="/Index" class="text-sm font-medium text-accent hover:underline">Strona</a>
            </div>

            <nav class="space-y-1 px-3 pb-6" aria-label="Nawigacja panelu">
                <a asp-page="/Admin/Index" class="block rounded-xl px-3 py-2 text-sm font-medium hover:bg-stone-100">Dashboard</a>
                <a asp-page="/Admin/Systemy/Index" class="block rounded-xl px-3 py-2 text-sm font-medium hover:bg-stone-100">Systemy</a>
                <a asp-page="/Admin/Tresci/Index" class="block rounded-xl px-3 py-2 text-sm font-medium hover:bg-stone-100">Treści stron</a>
                <a asp-page="/Index" asp-route-adminPreview="1" class="block rounded-xl px-3 py-2 text-sm font-medium hover:bg-stone-100">Podgląd strony</a>
            </nav>

            <form method="post" asp-page="/Admin/Login" asp-page-handler="Logout" class="px-6 pb-6">
                <button type="submit" class="inline-flex rounded-xl border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-50">Wyloguj</button>
            </form>
        </aside>

        <main class="px-4 py-6 md:px-8">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
